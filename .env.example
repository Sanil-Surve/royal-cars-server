# =================================================================
# Royal Cars Server Environment Variables (.env.example)
# =================================================================

# ----------------- MongoDB Configuration (Required) --------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=royal_cars

# ----------------- Authentication & Security (Required) ----------
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Admin Credentials (seeded on startup)
ADMIN_EMAIL=admin@royalcars.in
ADMIN_PASSWORD=Admin@12345

# ----------------- Application / Frontend URLs -------------------
APP_NAME=royalcars
FRONTEND_URL=http://localhost:5173

# ----------------- Cloudinary (Vehicle & KYC Uploads) -------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------- Razorpay (Payments) ---------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=

# ----------------- Resend (Email Notifications) ------------------
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=Royal Cars <booking@royalrentalcars.in>
